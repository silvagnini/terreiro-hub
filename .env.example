# Banco (o Railway preenche DATABASE_URL ao ligar o serviço Postgres)
DATABASE_URL=postgres://postgres@127.0.0.1:5433/terreiro
DATABASE_SSL=false
DB_POOL_MAX=20

# Servidor
PORT=8080
NODE_ENV=development
APP_URL=http://localhost:8080
RODAR_ROTINAS=true

# Admin criado no primeiro start (só se ainda não existir admin)
ADMIN_EMAIL=voce@exemplo.com
ADMIN_SENHA=troque-esta-senha

# Pagamentos: "simulado" (padrão) ou "asaas"
GATEWAY=simulado
# Token que o gateway envia no cabeçalho asaas-access-token (32 a 255 caracteres aleatórios)
WEBHOOK_TOKEN=
# Só com GATEWAY=asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
